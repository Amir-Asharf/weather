import 'package:flutter_bloc/flutter_bloc.dart';
import 'package:weather_app/repositories/weather_repository.dart';

import 'weather_event.dart';
import 'weather_state.dart';

class WeatherBloc extends Bloc<WeatherEvent, WeatherState> {
  final WeatherRepository weatherRepository;

  WeatherBloc({required this.weatherRepository}) : super(WeatherInitial()) {
    on<GetWeatherByCity>(_onGetWeatherByCity);
    on<GetWeatherByLocation>(_onGetWeatherByLocation);
  }

  Future<void> _onGetWeatherByCity(
    GetWeatherByCity event,
    Emitter<WeatherState> emit,
  ) async {
    try {
      emit(WeatherLoading());
      final weather = await weatherRepository.getWeatherByCity(event.city);
      emit(WeatherLoaded(weather));
    } catch (e) {
      emit(WeatherError(e.toString()));
    }
  }

  Future<void> _onGetWeatherByLocation(
    GetWeatherByLocation event,
    Emitter<WeatherState> emit,
  ) async {
    try {
      emit(WeatherLoading());
      final weather = await weatherRepository.getWeatherByLocation(
        event.latitude,
        event.longitude,
      );
      emit(WeatherLoaded(weather));
    } catch (e) {
      emit(WeatherError(e.toString()));
    }
  }
}
